# Copy to .env.local. .env.local is gitignored.
# The active harness uses locally authenticated CLIs, not Ollama or an API key.
# EverOS is only the assistant-only exact-key store, so its configured LLM slot
# is a local unused placeholder; do not use this root for extraction endpoints.
CONTEXTMESH_EVEROS_URL=http://127.0.0.1:8000
CONTEXTMESH_SUMMARIZER_COMMAND=claude
CONTEXTMESH_SUMMARIZER_MODEL=sonnet
CONTEXTMESH_SUMMARIZER_MAX_BUDGET_USD=0.50
CONTEXTMESH_SUM_TIMEOUT_MS=65000
CONTEXTMESH_SUMMARIZER_CONCURRENCY=1
