# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
# The model provider is Ollama Cloud (OpenAI-protocol). Swap for any
# OpenAI-compatible endpoint by changing these three values + the Tollgate route.
OLLAMA_API_KEY=your-ollama-cloud-key-here
OLLAMA_BASE_URL=https://ollama.com/v1
CONTEXTMESH_MODEL=deepseek-v4-flash:preview
