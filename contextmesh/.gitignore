# secrets — never commit
.env.local

# per-run artifacts (bench outputs, tmux logs, token JSONL, pidfiles)
runs/

# EverOS memory root — runtime data + machine-generated config (everos init regenerates it)
everos-root/
everos-native-root/
.codex-rrd-native/

# stray plugin metrics written when CONTEXTMESH_LOG is unset
.contextmesh-metrics.jsonl
*.jsonl

# bundled plugin build artifact (regenerate: bun build plugin/contextmesh.ts)
plugin/contextmesh.js

# logs
*.log
