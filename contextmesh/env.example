# Optional native Codex demo settings. Launchers do not source this file.
# Export RRD_CODEX_BIN as the canonical absolute path printed by:
#   python3 -c 'import os,shutil; print(os.path.realpath(shutil.which("codex")))'
RRD_CODEX_BIN=/absolute/path/to/codex
RRD_CODEX_MODEL=gpt-5.5
RRD_CODEX_REASONING=medium
RRD_WORKER_MODEL=gpt-5.4-mini
RRD_WORKER_REASONING=low
